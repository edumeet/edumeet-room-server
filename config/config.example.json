{
	"liveReload": false,
	"prometheus": {
		"enabled": false,
		"period": 10,
		"listener": [
			{
				"ip": "0.0.0.0",
				"port": 3080,
				"protocol": "http"
			},
			{
				"ip": "0.0.0.0",
				"port": 3043,
				"protocol": "https",
				"cert": {
					"cert": "./certs/edumeet-demo-cert.pem",
					"key": "./certs/edumeet-demo-key.pem"
				}
			}
		]
	},
	"listenPort": "8443",
	"listenHost": "0.0.0.0",
	"tls": {
		"cert": "./certs/edumeet-demo-cert.pem",
		"key": "./certs/edumeet-demo-key.pem"
	},
	"managementService": {
		"host": "http://localhost:3030",
		"jwtPublicKeys": [
			"REPLACE_WITH_THE_PUBLIC_KEY_OF_YOUR_MANAGEMENT_SERVER"
		]
	},
	"defaultRoomSettings": {
		"defaultRole": {
			"id": 0,
			"name": "Default",
			"description": "Default role",
			"permissions": [
				{ "name": "SEND_CHAT" },
				{ "name": "SHARE_AUDIO" },
				{ "name": "SHARE_VIDEO" },
				{ "name": "SHARE_SCREEN" },
				{ "name": "SHARE_EXTRA_VIDEO" },
				{ "name": "SHARE_FILE" },
				{ "name": "CHANGE_ROOM" }
			]
		},
		"maxActiveVideos": 12,
		"locked": false,
		"breakoutsEnabled": true,
		"chatEnabled": true,
		"raiseHandEnabled": true,
		"filesharingEnabled": true,
		"localRecordingEnabled": true,
		"endToEndEncryption": false
	},
	"countryToRegion": {
		"NO": "EEA",
		"PL": "EEA",
		"DE": [ "EEA", "DACH" ],
		"AT": [ "EEA", "DACH" ],
		"CH": "DACH",
		"UA": "UA"
	},
	"defaultAllowedMediaNodeRegions": [],
	"clientMonitoring": {
		"roomInfo": false,
		"obfuscateRoomName": false
	},
	"mediaNodes": [{
		"hostname": "localhost",
		"port": 3000,
		"secret": "secret-shared-with-media-node",
		"latitude": 63.430481,
		"longitude": 10.394964,
		"country": "NO",
		"turnHostname": "localhost",
		"turnports" :  [
			{
				"protocol":"turn",
				"port": 80,
				"transport": "udp"
			},
			{
				"protocol":"turns",
				"port": 443,
				"transport": "tcp"
			}
		]
	}]
}
